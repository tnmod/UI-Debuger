{
    "manifest_version": 3,
    "name": "CSS Outliner",
    "version": "1.1.0",
    "description": "Add/Remove CSS outlines for HTML elements",
    "permissions": [
      "activeTab",
      "scripting",
      "storage"
    ],
    "action": {
      "default_icon": "icon.png",
      "default_title": "CSS Outliner",
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    }
  }